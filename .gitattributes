# LF in the repo on every platform. The format check runs on Linux and would
# otherwise flag every line of a file committed from Windows with CRLF.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

# The only DBN files here are the decoder fixtures in tests/data. Marking them
# binary keeps eol=lf above from rewriting bytes the tests compare exactly.
*.dbn      binary
*.dbn.zst  binary
*.zst      binary

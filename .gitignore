# Market data — never committed.
*.dbn
*.dbn.zst
*.zst

# Databento batch job directories (GLBX-YYYYMMDD-XXXXXXXXXX/)
GLBX-*/
data/
lake/

# Batch sidecars — small, but they describe a specific licensed purchase
condition.json
manifest.json
metadata.json

# Build
build/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# pybind11 extension output
*.pyd
*.egg-info/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Private working documents — the spec names engine internals from another
# repo, and this one is public.
spec.md
.claude/

# Reports
reports/
reviews/
ctest_out.txt
*.perf
perf.data*

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# The one exception to the rules above: tests/data holds Databento's own
# Apache-2.0 DBN test vectors, not market data. The directory has to be
# re-included before its contents, because git will not descend into an
# excluded directory to find a negation.
!tests/data/
!tests/data/**

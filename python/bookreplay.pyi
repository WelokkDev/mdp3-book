"""Type stubs for the bookreplay extension module."""

from __future__ import annotations

from typing import Sequence

NO_OCO_GROUP: int
ANY_INSTRUMENT: int
NEVER_NS: int

class BookreplayError(Exception): ...
class DbnError(BookreplayError): ...
class ReplayError(BookreplayError): ...

class Side:
    BID: Side
    ASK: Side
    NONE: Side

class OrderType:
    MARKET: OrderType
    LIMIT: OrderType
    STOP: OrderType
    STOP_LIMIT: OrderType

class LatencyClass:
    ORDER_ENTRY: LatencyClass
    PROTECTION_ARM: LatencyClass

class OrderStatus:
    PENDING: OrderStatus

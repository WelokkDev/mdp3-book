class NoAggressorPolicy:
    NEITHER_SIDE: NoAggressorPolicy
    BOTH_SIDES: NoAggressorPolicy

class FillSizePolicy:
    PRINT_CAPPED: FillSizePolicy
    FULL_REMAINING: FillSizePolicy


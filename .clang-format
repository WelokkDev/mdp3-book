---
Language: Cpp
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
SeparateDefinitionBlocks: Always

# Project headers first and unmistakable, then the standard library. A book
# reconstructor lives on <cstdint> and <limits>; keeping those visually
# distinct from our own headers makes a missing include obvious in review.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"bookreplay/'
    Priority: 1
  - Regex: '^<gtest/'
    Priority: 3
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '.*'
    Priority: 4
